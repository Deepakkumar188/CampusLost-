# CampusLost+ Environment Configuration
# Copy this file to .env and fill in your Gemini API key.
# NEVER commit .env to version control.

GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 model ID served via the Gemini API (google-genai SDK).
# Supported Gemma 4 IDs in Gemini API:
#   - gemma-4-31b-it      (Gemma 4 31B Dense Instruction-Tuned)
#   - gemma-4-26b-a4b-it  (Gemma 4 26B MoE / 4B Active Instruction-Tuned)
# TODO: Verify multimodal/image support on your chosen GEMMA_MODEL endpoint.
GEMMA_MODEL=gemma-4-31b-it

# Optional SQLite database path override
DATABASE_PATH=campus_lost_plus.db
